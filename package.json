{
  "name": "bosco-vivant",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "python3 scripts/render-transition-evidence.py && npm run build && node --test tests/rendered-html.test.mjs tests/bosco-step6b.test.mjs tests/bosco-step7.test.mjs tests/bosco-step7b.test.mjs tests/bosco-transitions.test.mjs tests/bosco-v22-evidence.test.mjs tests/bosco-v22-responsive.test.mjs tests/marine-interface.test.mjs tests/bosco-carousel-story.test.mjs tests/manche-map.test.mjs && node --import tsx --test tests/bosco-intro.test.ts tests/bosco-dialogue-engine.test.ts tests/emile-advice.test.ts tests/bosco-v24.test.ts tests/bosco-v25.test.ts tests/bosco-v26.test.ts tests/bosco-v27-mont-saint-michel.test.ts",
    "test:emile": "node --import tsx --test tests/emile-advice.test.ts",
    "test:dialogues": "node --import tsx --test tests/bosco-dialogue-engine.test.ts",
    "dialogue:corpus": "node --import tsx scripts/generate-dialogue-control.mts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit -p tsconfig.app.json",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Bosco vivant"
}
