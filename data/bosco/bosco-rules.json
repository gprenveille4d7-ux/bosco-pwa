          {
            "field": "data.status",
            "op": "in",
            "value": [
              "unavailable",
              "invalid"
            ]
          }
        ],
        "none": []
      },
      "output": {
        "terminal": true,
        "decision": "decision-unavailable",
        "emotion": "perplexe",
        "dialogue": "aucune-donnee",
        "confidenceCap": 0
