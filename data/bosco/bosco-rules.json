{
  "schemaVersion": "4.0.0",
  "evaluation": {
    "order": "priority-desc",
    "mode": "first-terminal-plus-advisories",
    "operators": [
      "eq",
      "neq",
      "gt",
      "gte",
      "lt",
      "lte",
      "in",
      "notIn",
      "exists",
      "missing"
    ]
  },
  "safetyGates": [
    {
      "id": "data-unavailable",
      "priority": 1000,
      "when": {
        "all": [],
