{
  "schemaVersion": "5.0.0",
  "status": "implemented-procedurally",
  "masterGain": 0.075,
  "defaultEnabled": false,
  "batteryPolicy": {
    "suspendWhenHidden": true,
    "disableOnSaveData": true,
    "maximumContinuousSources": 3,
    "fadeMs": 900
  },
  "layers": {
    "fireplace": {
      "generator": "filtered-brown-noise",
      "gain": 0.018,
      "always": true,
      "randomCracklePerMinute": {
        "min": 3,
        "max": 8
      }
    },
    "wood": {
      "generator": "short-low-impulse",
      "gain": 0.012,
      "eventsPerMinute": {
        "min": 1,
        "max": 3
      }
    },
    "wind": {
      "generator": "bandpass-noise",
      "gainByMeanWindKt": {
        "0": 0,
        "8": 0.008,
        "15": 0.018,
        "25": 0.034
      }
    },
    "rain": {
      "generator": "highpass-noise",
      "gainByRainMmH": {
        "0": 0,
        "1": 0.008,
        "5": 0.022,
        "10": 0.04
      }
    },
    "waves": {
      "generator": "slow-filtered-noise-swell",
      "gain": 0.012,
      "periodSeconds": {
        "min": 5,
        "max": 9
      }
    },
    "gulls": {
      "generator": "disabled-until-recorded-source-is-licensed",
      "eventsPerMinute": {
        "min": 0,
        "max": 1
      }
    },
    "harborBell": {
      "generator": "dual-sine-decay",
      "gain": 0.012,
      "eventsPerMinute": {
        "min": 0,
        "max": 1
      }
    },
    "cup": {
      "generator": "short-sine-clink",
      "gain": 0.018,
      "trigger": "cup-rest-or-lift"
    }
  },
  "mixes": {
    "clear": [
      "fireplace",
      "waves"
    ],
    "rain": [
      "fireplace",
      "rain",
      "wind"
    ],
    "storm": [
      "rain",
      "wind"
    ],
    "night": [
      "fireplace",
      "wood",
      "waves"
    ],
    "offline": [
      "fireplace",
      "wood"
    ]
  },
  "accessibility": {
    "separateFromVoiceControl": true,
    "neverMasksSafetySpeech": true,
    "duckDuringSpeechDb": -9
  }
}
