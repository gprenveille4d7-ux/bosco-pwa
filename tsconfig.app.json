{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "lib/**/*.mts",
    "data/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "db",
    "worker",
    "vite.config.ts"
  ]
}
